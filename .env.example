# Kopieer dit bestand naar ".env" (lokaal) of zet deze waarden als geheimen op de host (bijvoorbeeld: fly secrets set NAAM=waarde).
# Zet ".env" NOOIT online, in een publieke map of in een git-repository. Geheime sleutels horen alleen op de server.

# ---------- Algemeen ----------
# Het internetadres van je WEBSITE (het domein bij Netlify), zonder slash aan het eind. Moet https zijn:
# SumUp/Mollie melden betalingen via dit adres, en dat gaat via Netlify naar de server.
PUBLIC_URL=https://www.jouwdomein.nl
PORT=3000
# Waar de database en de back-ups staan. Op Fly.io: /data (de vaste schijf). Lokaal: leeg laten.
DATA_DIR=
# Op de echte server: production. De server start dan niet zolang er proef-inloggegevens zijn.
NODE_ENV=production

# ---------- Alleen verkeer via je website accepteren (Netlify) ----------
# Een lang willekeurig geheim (minstens 24 tekens). Zet DEZELFDE waarde in Netlify als NETLIFY_SIGN_SECRET.
NETLIFY_SIGN_SECRET=
# Alternatief als je geen Netlify gebruikt: een geheim dat de proxy meestuurt in de header x-shop-proxy
PROXY_SECRET=
# Naam van de header met het IP-adres van de bezoeker (vaak x-forwarded-for). Alleen gelezen als de aanvraag via de proxy komt.
# Zie /api/admin/debug-headers (als eigenaar) op de testomgeving om te zien welke header het goede IP bevat.
CLIENT_IP_HEADER=

# ---------- Online betalen ----------
# sumup (officiële SumUp Online Checkout) of mollie (als je iDEAL via Mollie wilt)
PAYMENT_PROVIDER=sumup
# SumUp: API-sleutel (https://me.sumup.com/settings/developer) en merchant code (begint met MC). Test eerst met een SANDBOX-account.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Zet op 1 ALLEEN als SumUp iDEAL voor jouw account heeft geactiveerd.
SUMUP_IDEAL=0
# Mollie (alleen als PAYMENT_PROVIDER=mollie): testsleutel begint met test_, live met live_
MOLLIE_API_KEY=

# ---------- Back-ups (zie HERSTEL-EN-BACKUPS.md) ----------
# Sleutel om back-ups te versleutelen (bewaar hem ook buiten de server!). Raak je hem kwijt, dan zijn de back-ups onleesbaar.
BACKUP_ENCRYPTION_KEY=
# Hoeveel back-ups lokaal bewaard blijven
BACKUP_KEEP=14
# Externe opslag met S3-protocol (Backblaze B2, Cloudflare R2, Hetzner Object Storage, AWS S3, ...)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=bassma/

# ---------- E-mail naar klanten ----------
# Zonder SMTP_HOST worden mails alleen als bestand opgeslagen (proefversie). Mislukte mails worden automatisch opnieuw geprobeerd.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bassma Lunchroom <bestellingen@jouwdomein.nl>"

# ---------- Privacy ----------
# Na zoveel dagen worden naam, telefoon, e-mail, adres en opmerking van bestellingen gewist (bedragen blijven bewaard).
RETENTION_DAYS=90
# Kopieën van mails (alleen zonder SMTP) worden na zoveel dagen gewist.
MAIL_COPY_DAYS=7

# ---------- Bonnen ----------
# Netwerkprinter met ESC/POS op een vast IP-adres. Werkt alleen als de server in hetzelfde netwerk draait als de printer.
# Draait de server in de cloud, laat dit dan leeg en gebruik "Bonnenmodus" in het beheer op de kassa of tablet.
PRINTER_HOST=
PRINTER_PORT=9100

# ---------- Alleen voor lokaal testen met de simulator (test/mock-sumup.js) ----------
# SUMUP_API_BASE=http://localhost:4010
# ALLOW_HTTP_WEBHOOK=1
