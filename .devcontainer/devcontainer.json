{
  "name": "Bassma webshop (testomgeving)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "24" } },
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Bassma webshop" } },
  "postCreateCommand": "npm install --omit=dev",
  "postStartCommand": "bash .devcontainer/start.sh"
}
