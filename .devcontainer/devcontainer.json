{
  "name": "Bassma webshop (testomgeving)",
  "image": "node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Bassma webshop" } },
